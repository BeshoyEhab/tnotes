#compdef tn
# zsh completion for tn — link into $fpath, e.g.:
#   ln -sf ~/tnotes/completions/_tn ~/.zsh/completions/_tn
_tn() {
    local -a subs opts
    subs=(
        'list:list entries'
        'search:search entries'
        'show:show entries'
        'open:open URL'
        'run:run command'
        'edit:edit entry'
        'rm:remove entry'
        'done:mark done'
        'undone:mark active'
        'hide:hide from autoshow'
        'unhide:show on open'
        'path:print store path'
        'tui:open TUI browser'
    )
    opts=(
        '(-g --all)'{-g,--all}'[scope flag]'
        '(-l)'{-l}'[this dir only]'
        '--all[all dirs (picker)]'
        '--done[include completed]'
        '--hidden[include hidden]'
        '--url[add URL]:url:'
        '--cmd[add command]:command:'
        '--note[add note]:note:'
        '--title[title]:title:'
        '--tags[comma tags]:tags:'
        '--no-show[hide from autoshow]'
        '-m[compose in editor]'
        '--startup[startup autoshow]'
        '--preview[preview rendering]'
    )
    _arguments -C $opts '1: :->sub' '*:: :->args' && return 0
    case "$state" in
        sub) _describe 'tn subcommand' subs ;;
        args)
            case "${words[2]}" in
                list|search|show|open|run) _arguments '--all[all dirs]' '-g[global]' '-l[local]' '--done[completed]' '--hidden[hidden]' '--startup[startup]' '--preview[preview]' ;;
            esac ;;
    esac
}
_tn "$@"
